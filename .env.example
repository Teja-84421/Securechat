# Copy this file to ".env" (in the project root) and fill in your values.
PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=securechat
# Hosted MySQL (Aiven etc.) needs an encrypted connection. Leave unset for local MySQL.
# DB_SSL=true

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional: "Continue with Google". See README -> "Google sign-in setup".
# Looks like 1234567890-abc123.apps.googleusercontent.com (a client ID is public, not a secret).
GOOGLE_CLIENT_ID=

# Frontend only (client/.env.production or Vercel env var): address of the deployed backend.
# Leave unset for local development.
# VITE_API_URL=https://your-backend.example.com
